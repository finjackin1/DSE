<Application x:Class="DSE.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:DSE.App.Ui">
    <Application.Resources>
        <ResourceDictionary>

            <!-- Tokens do padrão "app simples" (interface-simples / interface-polida).
                 Nada de cor escrita à mão fora daqui. As chaves antigas (Bg, Surface,
                 Accent...) continuam existindo, apontando pras cores novas. -->
            <Color x:Key="cFundo">#16161A</Color>
            <Color x:Key="cFundoFundo">#101013</Color>
            <Color x:Key="cCamada1">#1D1D22</Color>
            <Color x:Key="cBorda1">#2F2F37</Color>
            <Color x:Key="cBordaMouse">#4A4A54</Color>
            <Color x:Key="cCamada2">#25252C</Color>
            <Color x:Key="cSuperficie">#2C2C34</Color>
            <Color x:Key="cSuperficieBorda">#4C4C57</Color>
            <Color x:Key="cLinha">#2C2C33</Color>
            <Color x:Key="cTexto">#E9E6DF</Color>
            <Color x:Key="cTexto2">#9A978F</Color>
            <Color x:Key="cApagado">#6F6D68</Color>
            <Color x:Key="cAcento">#FF5A1F</Color>
            <Color x:Key="cVerde">#57C27A</Color>
            <Color x:Key="cAzul">#5AA9FF</Color>
            <Color x:Key="cErro">#FF5A5A</Color>
            <Color x:Key="cAlerta">#E8C15A</Color>
            <Color x:Key="cFoco">#8E8B93</Color>
            <Color x:Key="cFecharSegurar">#C42B1C</Color>

            <SolidColorBrush x:Key="FundoBrush" Color="{StaticResource cFundo}"/>
            <SolidColorBrush x:Key="FundoFundoBrush" Color="{StaticResource cFundoFundo}"/>
            <SolidColorBrush x:Key="Camada1Brush" Color="{StaticResource cCamada1}"/>
            <SolidColorBrush x:Key="Camada2Brush" Color="{StaticResource cCamada2}"/>
            <SolidColorBrush x:Key="Borda1Brush" Color="{StaticResource cBorda1}"/>
            <SolidColorBrush x:Key="BordaMouseBrush" Color="{StaticResource cBordaMouse}"/>
            <SolidColorBrush x:Key="SuperficieBrush" Color="{StaticResource cSuperficie}"/>
            <SolidColorBrush x:Key="SuperficieBordaBrush" Color="{StaticResource cSuperficieBorda}"/>
            <SolidColorBrush x:Key="LinhaBrush" Color="{StaticResource cLinha}"/>
            <SolidColorBrush x:Key="Texto2Brush" Color="{StaticResource cTexto2}"/>
            <SolidColorBrush x:Key="ApagadoBrush" Color="{StaticResource cApagado}"/>
            <SolidColorBrush x:Key="AlertaBrush" Color="{StaticResource cAlerta}"/>
            <SolidColorBrush x:Key="AlertaBordaBrush" Color="#7D6A3A"/>
            <SolidColorBrush x:Key="FocoBrush" Color="{StaticResource cFoco}"/>
            <SolidColorBrush x:Key="FecharSegurarBrush" Color="{StaticResource cFecharSegurar}"/>
            <SolidColorBrush x:Key="AzulBrush" Color="{StaticResource cAzul}"/>
            <!-- Realce do mouse: TEXTO a 10% por cima da cor do botão. -->
            <SolidColorBrush x:Key="RealceBrush" Color="#1AE9E6DF"/>

            <!-- Chaves antigas (assistente de drivers, ícones de bateria). -->
            <SolidColorBrush x:Key="BgBrush" Color="{StaticResource cFundoFundo}"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource cFundo}"/>
            <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource cCamada1}"/>
            <SolidColorBrush x:Key="BorderBrush2" Color="{StaticResource cBorda1}"/>
            <SolidColorBrush x:Key="TextBrush" Color="{StaticResource cTexto}"/>
            <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource cTexto2}"/>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource cAcento}"/>
            <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ConnectedBrush" Color="{StaticResource cVerde}"/>
            <SolidColorBrush x:Key="DisconnectedBrush" Color="{StaticResource cErro}"/>

            <FontFamily x:Key="Letra">Segoe UI Variable Text, Segoe UI</FontFamily>
            <FontFamily x:Key="LetraSemi">Segoe UI Variable Text Semibold, Segoe UI Semibold, Segoe UI</FontFamily>

            <Style TargetType="Window">
                <Setter Property="Background" Value="{StaticResource FundoBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource Letra}"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            </Style>

            <!-- Textos (tamanhos = pt da casa x 4/3; a janela escala 1,3 por cima) -->
            <Style x:Key="TitPainel" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource LetraSemi}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="TitTela" TargetType="TextBlock" BasedOn="{StaticResource TitPainel}">
                <Setter Property="FontSize" Value="16"/>
            </Style>
            <Style x:Key="Legenda" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{StaticResource Texto2Brush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
            <Style x:Key="Corpo" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- Painel: segmento sutil (CAMADA_1, borda LINHA, raio 12, folga 12) -->
            <Style x:Key="Painel" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Camada1Brush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource LinhaBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="12"/>
            </Style>

            <!-- Foco de teclado: borda FOCO arredondada (só aparece navegando por Tab) -->
            <Style x:Key="FocoArredondado">
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Border BorderBrush="{StaticResource FocoBrush}" BorderThickness="1.2" CornerRadius="8"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Botao: arredondado; selecionado = laranja com frente branca -->
            <Style TargetType="ui:Botao">
                <Setter Property="Cor" Value="{StaticResource Camada2Brush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource LetraSemi}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Raio" Value="10"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocoArredondado}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ui:Botao">
                            <Grid>
                                <Border x:Name="bd" Background="{TemplateBinding Cor}" CornerRadius="{TemplateBinding Raio}"/>
                                <Border x:Name="realce" Background="{StaticResource RealceBrush}"
                                        CornerRadius="{TemplateBinding Raio}" Visibility="Collapsed"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="realce" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="Selecionado" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                    <Setter TargetName="realce" Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="realce" Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Foreground" Value="{StaticResource ApagadoBrush}"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Chave (interruptor 40x22): laranja ligada, bolinha desliza em 0,15 s -->
            <Style x:Key="Chave" TargetType="CheckBox">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocoArredondado}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Border x:Name="trilho" Width="40" Height="22" CornerRadius="11"
                                    Background="{StaticResource Camada2Brush}"
                                    BorderBrush="{StaticResource BordaMouseBrush}" BorderThickness="1">
                                <Ellipse x:Name="bola" Width="14" Height="14" HorizontalAlignment="Left"
                                         Margin="3,0,0,0" Fill="{StaticResource Texto2Brush}">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="desliza" X="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="trilho" Property="Background" Value="{StaticResource AccentBrush}"/>
                                    <Setter TargetName="trilho" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    <Setter TargetName="bola" Property="Fill" Value="#FFFFFF"/>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="desliza" Storyboard.TargetProperty="X"
                                                                 To="18" Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="desliza" Storyboard.TargetProperty="X"
                                                                 To="0" Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Dica (tooltip) da casa -->
            <Style TargetType="ToolTip">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource Letra}"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="{StaticResource SuperficieBrush}"
                                    BorderBrush="{StaticResource SuperficieBordaBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="10,5">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="DarkToolTip" TargetType="ToolTip" BasedOn="{StaticResource {x:Type ToolTip}}"/>

            <!-- Menu da bandeja (botão direito). Medidas já na escala 1,3 da janela,
                 como a dica: o menu é janela à parte e não herda a escala. -->
            <Style TargetType="ContextMenu">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource Letra}"/>
                <Setter Property="FontSize" Value="15"/>
                <!-- True = popup com transparência: sem isso os cantos redondos saem pretos.
                     A moldura não desenha sombra, então nada muda no visual. -->
                <Setter Property="HasDropShadow" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border Background="{StaticResource SuperficieBrush}"
                                    BorderBrush="{StaticResource SuperficieBordaBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="5" MinWidth="230">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="Separator">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Separator">
                            <Border Height="1" Margin="10,5" Background="{StaticResource LinhaBrush}"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="MenuItem">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource Letra}"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="8,7,12,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path x:Name="Marca" Data="M1,6 L5,10 L12,2" Stroke="{StaticResource AccentBrush}"
                                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          VerticalAlignment="Center" Visibility="Hidden"/>
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="False"
                                                      VerticalAlignment="Center"/>
                                    <Path x:Name="Seta" Grid.Column="2" Data="M0,0 L4,4.5 L0,9" Stroke="{StaticResource Texto2Brush}"
                                          StrokeThickness="1.6" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="0" VerticalOffset="-6"
                                           IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                           AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                                        <Border Background="{StaticResource SuperficieBrush}"
                                                BorderBrush="{StaticResource SuperficieBordaBrush}" BorderThickness="1"
                                                CornerRadius="10" Padding="5" MinWidth="210">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Marca" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="HasItems" Value="True">
                                    <Setter TargetName="Seta" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource RealceBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource ApagadoBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Botões do assistente de drivers -->
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="FontFamily" Value="{StaticResource LetraSemi}"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource Camada2Brush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource ApagadoBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource Camada2Brush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource LetraSemi}"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border Background="{TemplateBinding Background}" CornerRadius="8"/>
                                <Border x:Name="realce" Background="{StaticResource RealceBrush}" CornerRadius="8" Visibility="Collapsed"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="realce" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Rolagem: barra fina (3) só quando passa; sem setas -->
            <Style x:Key="ThinScrollThumb" TargetType="Thumb">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="{StaticResource BordaMouseBrush}" CornerRadius="2"
                                    Width="3" HorizontalAlignment="Right"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="6"/>
                <Setter Property="MinWidth" Value="6"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ThinScrollThumb}"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
