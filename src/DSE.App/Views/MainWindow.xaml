<Window x:Class="DSE.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DSE"
        Width="650" Height="520"
        Icon="/Assets/dse_icon.ico"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{StaticResource FundoBrush}"
        UseLayoutRounding="True"
        Closing="OnWindowClosing">

    <!-- Janela FIXA 5:4 (padrão "app simples"): 500x400 de base x 1,3 = 650x520.
         Nenhuma troca de tela muda o tamanho. A borda de 1 px só aparece fora do
         Windows 11 (lá a borda e os cantos são do próprio sistema). -->
    <Border x:Name="Moldura" Background="{StaticResource FundoBrush}" BorderBrush="{StaticResource SuperficieBordaBrush}" BorderThickness="0">
        <Grid Width="500" Height="400" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid.LayoutTransform>
                <ScaleTransform ScaleX="1.3" ScaleY="1.3"/>
            </Grid.LayoutTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== BARRA (34) ===== -->
            <Grid x:Name="Barra" Grid.Row="0" Background="{StaticResource FundoFundoBrush}"
                  MouseLeftButtonDown="OnBarraArrastar">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Image Source="/Assets/dse_icon.png" Width="16" Height="16" Margin="10,0,6,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="DSE" FontFamily="{StaticResource LetraSemi}" FontSize="13.3"
                               Foreground="{StaticResource Texto2Brush}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="BotoesBarra" Orientation="Horizontal" HorizontalAlignment="Right"/>
            </Grid>

            <!-- ===== CORPO ===== -->
            <Grid Grid.Row="1" Margin="12,10,12,6">

                <!-- Tela principal: duas colunas -->
                <Grid x:Name="TelaInicio">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="222"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Esquerda: controles do selecionado -->
                    <StackPanel x:Name="ColunaControles" Grid.Column="0">
                        <Border Style="{StaticResource Painel}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="Perfil" Style="{StaticResource TitPainel}"/>
                                    <TextBlock Text="como o jogo vê o controle" Style="{StaticResource Legenda}" Margin="6,0,0,0"/>
                                </DockPanel>
                                <UniformGrid x:Name="LinhaPerfis" Columns="2" Margin="0,10,0,0" Height="56"/>
                                <Border x:Name="HostDesativar" Margin="0,6,0,0" Height="38"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Painel}" Margin="0,10,0,0">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="Luz" Style="{StaticResource TitPainel}"/>
                                    <TextBlock x:Name="LegendaLuz" Text="cor da barra de luz" Style="{StaticResource Legenda}" Margin="6,0,0,0"/>
                                </DockPanel>
                                <UniformGrid x:Name="LinhaLuz" Columns="2" Margin="0,10,0,0" Height="34"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Esquerda, sem controle: a DICA ocupa a coluna -->
                    <Border x:Name="PainelDica" Grid.Column="0" Style="{StaticResource Painel}"
                            BorderBrush="{StaticResource AlertaBordaBrush}" Visibility="Collapsed">
                        <DockPanel LastChildFill="True">
                            <Border x:Name="HostBotaoDica" DockPanel.Dock="Bottom" Height="34" Margin="0,10,0,0"/>
                            <StackPanel>
                                <TextBlock x:Name="DicaTitulo" FontFamily="{StaticResource LetraSemi}" FontSize="14"
                                           Foreground="{StaticResource AlertaBrush}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="DicaTexto" FontSize="12.7" Foreground="{StaticResource Texto2Brush}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="17"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Direita: controles conectados + imagem do selecionado -->
                    <Border Grid.Column="2" Style="{StaticResource Painel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0">
                                <TextBlock Text="Controles" Style="{StaticResource TitPainel}"/>
                                <TextBlock x:Name="LegendaControles" Style="{StaticResource Legenda}" Margin="6,0,0,0"/>
                            </DockPanel>
                            <ScrollViewer Grid.Row="1" MaxHeight="96" Margin="0,8,0,0"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="ListaControles"/>
                            </ScrollViewer>
                            <Border x:Name="HostImagem" Grid.Row="2" Margin="0,8,0,0"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Opções: uma coluna larga que rola -->
                <DockPanel x:Name="TelaOpcoes" Visibility="Collapsed">
                    <StackPanel x:Name="TituloOpcoes" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8"/>
                    <ScrollViewer x:Name="RolOpcoes" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,4,0">
                            <Border Style="{StaticResource Painel}">
                                <StackPanel x:Name="PainelPrograma">
                                    <TextBlock Text="Programa" Style="{StaticResource TitPainel}" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Painel}" Margin="0,10,0,0">
                                <StackPanel>
                                    <DockPanel>
                                        <Border x:Name="HostNovoAtalho" DockPanel.Dock="Right"/>
                                        <TextBlock Text="Atalhos do teclado" Style="{StaticResource TitPainel}"/>
                                        <TextBlock Text="Ctrl, Alt ou Win + uma tecla"
                                                   Style="{StaticResource Legenda}" Margin="6,0,0,0"/>
                                    </DockPanel>
                                    <StackPanel x:Name="ListaAtalhos"/>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="RodapeOpcoes" FontSize="11.3" Foreground="{StaticResource ApagadoBrush}"
                                       Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <!-- Ajuda: o que cada atalho do controle faz -->
                <DockPanel x:Name="TelaAjuda" Visibility="Collapsed">
                    <StackPanel x:Name="TituloAjuda" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ConteudoAjuda" Margin="0,0,4,0"/>
                    </ScrollViewer>
                </DockPanel>
            </Grid>

            <!-- ===== RODAPÉ: indicador + estado ===== -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="12,0,12,8">
                <ContentControl x:Name="Indicador" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock x:Name="IndicadorTexto" FontSize="12" Foreground="{StaticResource Texto2Brush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
