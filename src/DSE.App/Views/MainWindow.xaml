<Window x:Class="DSE.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DSE"
        Width="820" Height="880"
        Icon="/Assets/dse_icon.ico"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Closing="OnWindowClosing">

    <!-- Container externo com borda arredondada e o fundo do app -->
    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== BARRA DE TÍTULO CUSTOMIZADA ===== -->
            <Border Grid.Row="0" Background="{StaticResource Surface2Brush}" CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="OnTitleBarDrag" Height="52">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Ícone do app + nome -->
                    <Image Grid.Column="0" Source="/Assets/dse_icon.png" Width="32" Height="32"
                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Grid.Column="1" Text="DSE" FontSize="17" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                               Margin="10,0,0,0"/>

                    <!-- Botão: nova versão. Fica escondido e só aparece quando a
                         checagem encontra uma release mais nova. -->
                    <Button x:Name="UpdateBtn" Grid.Column="2" Style="{StaticResource TitleBarIconButton}"
                            Visibility="Collapsed" Click="OnUpdateDownloadClick"
                            ToolTipService.InitialShowDelay="2000">
                        <Button.ToolTip>
                            <ToolTip x:Name="UpdateTip" Style="{StaticResource DarkToolTip}"
                                     Content="Nova versão disponível"/>
                        </Button.ToolTip>
                        <!-- Seta para baixo sobre uma base: símbolo de baixar. -->
                        <Grid Width="15" Height="15">
                            <Path Fill="{StaticResource ConnectedBrush}" Stretch="Uniform"
                                  Margin="1,0,1,4"
                                  Data="M6,0 L10,0 L10,5 L13,5 L8,10.5 L3,5 L6,5 Z"/>
                            <Rectangle Fill="{StaticResource ConnectedBrush}" Height="1.8" Width="12"
                                       RadiusX="0.9" RadiusY="0.9" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Button>

                    <!-- Botão: Ajuda (abre o painel de atalhos) -->
                    <Button x:Name="HelpBtn" Grid.Column="3" Style="{StaticResource TitleBarIconButton}"
                            Click="OnHelpClick" ToolTipService.InitialShowDelay="2000">
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource DarkToolTip}" Content="Atalhos e ajuda"/>
                        </Button.ToolTip>
                        <Grid Width="16" Height="16">
                            <Ellipse Stroke="{StaticResource TextBrush}" StrokeThickness="1.5"/>
                            <TextBlock Text="?" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <!-- Botão: Iniciar com o Windows (ícone Win11 que acende/apaga) -->
                    <Button x:Name="StartWithWindowsBtn" Grid.Column="4" Style="{StaticResource TitleBarIconButton}"
                            Click="OnStartWithWindowsToggle" ToolTipService.InitialShowDelay="2000">
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource DarkToolTip}" Content="Iniciar com o Windows"/>
                        </Button.ToolTip>
                        <Grid x:Name="WindowsIcon" Width="16" Height="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="2"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Row="0" Grid.Column="0" Fill="#0078D4"/>
                            <Rectangle Grid.Row="0" Grid.Column="2" Fill="#0078D4"/>
                            <Rectangle Grid.Row="2" Grid.Column="0" Fill="#0078D4"/>
                            <Rectangle Grid.Row="2" Grid.Column="2" Fill="#0078D4"/>
                        </Grid>
                    </Button>

                    <!-- Botão: Abrir janela ao iniciar o programa (acende/apaga) -->
                    <Button x:Name="OpenOnStartupBtn" Grid.Column="6" Style="{StaticResource TitleBarIconButton}"
                            Click="OnOpenOnStartupToggle" ToolTipService.InitialShowDelay="2000">
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource DarkToolTip}" Content="Abrir janela ao iniciar o programa"/>
                        </Button.ToolTip>
                        <Grid x:Name="OpenOnStartupIcon" Width="16" Height="16">
                            <!-- Ícone de janela: moldura + barra de título -->
                            <Border BorderBrush="{StaticResource TextBrush}" BorderThickness="1.6" CornerRadius="2"/>
                            <Border Background="{StaticResource TextBrush}" Height="4" VerticalAlignment="Top"
                                    CornerRadius="2,2,0,0"/>
                        </Grid>
                    </Button>

                    <!-- Botão: Minimizar (pra bandeja) -->
                    <Button Grid.Column="5" Style="{StaticResource TitleBarIconButton}"
                            Click="OnMinimizeClick" ToolTipService.InitialShowDelay="2000">
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource DarkToolTip}" Content="Minimizar para a bandeja"/>
                        </Button.ToolTip>
                        <Path Width="14" Height="14" Stretch="Uniform" Stroke="{StaticResource TextBrush}"
                              StrokeThickness="1.6" Data="M2,10 L12,10"/>
                    </Button>

                    <!-- Botão: Fechar -->
                    <Button Grid.Column="7" Style="{StaticResource TitleBarCloseButton}"
                            Click="OnCloseClick" ToolTipService.InitialShowDelay="2000">
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource DarkToolTip}" Content="Fechar o programa"/>
                        </Button.ToolTip>
                        <Path Width="12" Height="12" Stretch="Uniform" Stroke="{StaticResource TextBrush}"
                              StrokeThickness="1.6" Data="M2,2 L12,12 M12,2 L2,12"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ===== CONTEÚDO ===== -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.LayoutTransform>
                    <ScaleTransform ScaleX="1.3" ScaleY="1.3"/>
                </Grid.LayoutTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="StatusText" Grid.Row="0" Text="Nenhum controle conectado"
                           Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,12"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ControllersPanel"/>
                </ScrollViewer>
            </Grid>

            <!-- ===== PAINEL DE ATALHOS (sobreposto ao conteúdo) ===== -->
            <!-- Fica na mesma linha do conteúdo, mas FORA do ScaleTransform dele,
                 pra não herdar a escala de 1.3x. Cobre só o conteúdo: a barra de
                 título continua acessível, e o próprio botão de ajuda fecha. -->
            <Grid x:Name="HelpOverlay" Grid.Row="1" Visibility="Collapsed"
                  Background="#E014161A" MouseLeftButtonDown="OnHelpBackdropClick">

                <Border Background="{StaticResource Surface2Brush}" CornerRadius="14"
                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                        MaxWidth="740" Margin="20"
                        VerticalAlignment="Center" HorizontalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Cabeçalho do painel -->
                        <Grid Grid.Row="0" Margin="26,16,14,0">
                            <TextBlock Text="Atalhos" FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource TitleBarIconButton}" HorizontalAlignment="Right"
                                    Click="OnHelpCloseClick">
                                <Path Width="12" Height="12" Stretch="Uniform" Stroke="{StaticResource TextBrush}"
                                      StrokeThickness="1.6" Data="M2,2 L12,12 M12,2 L2,12"/>
                            </Button>
                        </Grid>

                        <!-- O ScrollViewer fica como rede de segurança: com a janela
                             neste tamanho o conteúdo cabe inteiro e a barra não aparece. -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      Margin="26,6,26,18">
                            <StackPanel>

                                <TextBlock Text="NO CONTROLE" FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}" Margin="0,4,0,10"/>

                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="7"
                                            Padding="11,6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="Share + Options" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Alterna o perfil: Xbox 360 ou DualShock 4"
                                               FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextBrush}" Margin="14,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="7"
                                            Padding="11,6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="PS por 1 segundo" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Desliga o controle — só por Bluetooth"
                                               FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextBrush}" Margin="14,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="7"
                                            Padding="11,6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="Options + PS por 1s" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Liga ou desliga a emulação daquele controle"
                                               FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextBrush}" Margin="14,0,0,0"/>
                                </Grid>

                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="7"
                                            Padding="11,6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="Touchpad + PS por 1s" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Alterna o LED entre a cor do perfil e a cor que o jogo pedir"
                                               FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextBrush}" Margin="14,0,0,0"/>
                                </Grid>

                                <TextBlock Text="Os dois atalhos do PS funcionam mesmo com a emulação desativada, enquanto o DSE estiver aberto."
                                           FontSize="12.5" TextWrapping="Wrap" Margin="0,7,0,0"
                                           Foreground="{StaticResource MutedBrush}"/>

                                <TextBlock Text="NA JANELA" FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}" Margin="0,17,0,10"/>

                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="7"
                                            Padding="11,6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="Clique no controle" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Liga ou desliga a emulação dele"
                                               FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextBrush}" Margin="14,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="7"
                                            Padding="11,6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="Clique no touchpad" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Alterna o LED entre a cor do perfil e a cor que o jogo pedir"
                                               FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextBrush}" Margin="14,0,0,0"/>
                                </Grid>

                                <TextBlock Text="BOTÕES DA BARRA" FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}" Margin="0,17,0,10"/>

                                <TextBlock FontSize="14" TextWrapping="Wrap" LineHeight="24"
                                           Foreground="{StaticResource TextBrush}">
                                    <Run Text="?" FontWeight="Bold"/><Run Text="   este painel de atalhos" Foreground="#9AA0AA"/><LineBreak/>
                                    <Run Text="⊞" FontWeight="Bold"/><Run Text="   iniciar o DSE junto com o Windows" Foreground="#9AA0AA"/><LineBreak/>
                                    <Run Text="—" FontWeight="Bold"/><Run Text="   minimizar para a bandeja" Foreground="#9AA0AA"/><LineBreak/>
                                    <Run Text="▢" FontWeight="Bold"/><Run Text="   abrir a janela ao iniciar (apagado: vai direto pra bandeja)" Foreground="#9AA0AA"/><LineBreak/>
                                    <Run Text="✕" FontWeight="Bold"/><Run Text="   fechar o programa" Foreground="#9AA0AA"/>
                                </TextBlock>

                                <TextBlock Text="Os ícones acesos indicam opção ativa. Com o DSE na bandeja, um duplo clique no ícone reabre a janela."
                                           FontSize="12.5" TextWrapping="Wrap" Margin="0,10,0,0"
                                           Foreground="{StaticResource MutedBrush}"/>

                                <TextBlock Text="BOM SABER" FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}" Margin="0,17,0,10"/>

                                <TextBlock FontSize="13" TextWrapping="Wrap" LineHeight="21"
                                           Foreground="{StaticResource TextBrush}" Margin="0,0,0,7">
                                    <Run Text="Segurar o PS por cerca de 10 segundos desliga o controle."
                                         FontWeight="SemiBold"/>
                                    <Run Text=" Isso é do próprio controle e acontece até com o DSE fechado. Ao usar os atalhos acima, solte os botões assim que sentir a vibração — continuar segurando desliga o aparelho."/>
                                </TextBlock>

                                <TextBlock FontSize="13" TextWrapping="Wrap" LineHeight="21"
                                           Foreground="{StaticResource TextBrush}">
                                    <Run Text="Mantenha o firmware do controle atualizado." FontWeight="SemiBold"/>
                                    <Run Text=" Melhora a compatibilidade e corrige falhas. No DualSense, pelo aplicativo PlayStation Accessories (Microsoft Store) ou por um PS5; no DualShock 4, por um PS4."/>
                                </TextBlock>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
